# Скопируй в .env и заполни. Ключи — только здесь, в код не попадают.

# Модель: OpenAI-совместимый эндпоинт. Ключ подбирается по base_url (groq / yandex / иначе openrouter),
# LLM_API_KEY_OVERRIDE — если нужен произвольный.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m2.7:free
OPENROUTER_API_KEY=
# Судья эвалов — всегда через OpenRouter, независимо от адреса агента.
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
YANDEX_API_KEY=
# Варианты: Groq — LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-20b
#           Яндекс — LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1, LLM_MODEL=gpt://<folder>/deepseek-v4-flash/latest

# Данные и сервисы
DATA_DIR=data
REPORT_SOURCE=snapshot            # snapshot | sqlite
INDEX_PATH=.cache/snapshot.sqlite
MCP_TRANSPORT=stdio               # stdio | streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8765
API_HOST=127.0.0.1
API_PORT=8080
RECURSION_LIMIT=16
RUNS_DIR=runs
