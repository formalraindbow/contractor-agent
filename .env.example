# Скопируй в .env и заполни. Ключи — только здесь, в код не попадают.

# Модель: OpenAI-совместимый эндпоинт. Ключ подбирается по base_url (polza / groq / yandex / иначе openrouter),
# LLM_API_KEY_OVERRIDE — если нужен произвольный.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_MAX_TOKENS=8192 # ограничение генерации, включая рассуждение
LLM_FALLBACK_MODELS=
LLM_PROVIDER_ORDER=
LLM_PROVIDER_ALLOW_FALLBACKS=true
OPENROUTER_API_KEY=
# Судья эвалов — другое семейство моделей; его качество проверяем отдельно.
JUDGE_MODEL=z-ai/glm-5.3-flash
JUDGE_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
YANDEX_API_KEY=
POLZA_API_KEY=
# Polza: LLM_BASE_URL=https://polza.ai/api/v1, LLM_MODEL=openai/gpt-oss-20b,
# JUDGE_BASE_URL=https://polza.ai/api/v1, JUDGE_MODEL=z-ai/glm-5.3-flash,
# LLM_FALLBACK_MODELS= (пусто, чтобы результаты относились к выбранной модели).
# Для приоритета хостинга той же 20B в Polza: LLM_PROVIDER_ORDER=groq,akashml.
# Это переключение провайдеров, а не моделей. Судья не наследует этот порядок.
# Варианты: Groq — LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-20b
#           Яндекс — LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1, LLM_MODEL=gpt://<folder>/deepseek-v4-flash/latest

# Данные и сервисы
DATA_DIR=data
REPORT_SOURCE=snapshot            # snapshot | sqlite
INDEX_PATH=.cache/snapshot.sqlite
MCP_TRANSPORT=stdio               # stdio | streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8765
API_HOST=127.0.0.1
API_PORT=8080
RECURSION_LIMIT=16
RUNS_DIR=runs

# Пароль публичного стенда. Локально не нужен — оставьте пустым и страница откроется сразу.
# Если стенд выставляется наружу (туннель), задайте пароль: в данных ИНН физлиц.
WEB_PASSWORD=

# Диалоги: sqlite — переживают перезапуск страницы и сервиса, memory — только в памяти процесса
SESSION_STORE=sqlite
SESSION_DB_PATH=.cache/sessions.sqlite
