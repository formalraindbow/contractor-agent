# Скопируй в .env и заполни. Ключи — только здесь, в код не попадают.

# Модель: OpenAI-совместимый эндпоинт. Ключ подбирается по base_url (groq / yandex / иначе openrouter),
# LLM_API_KEY_OVERRIDE — если нужен произвольный.
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_MODEL=gpt://<folder-id>/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
RUN_TIMEOUT_S=180
# В сравнении моделей/веток резервы обязательно отключены.
LLM_FALLBACK_MODELS=
YANDEX_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Судья запускается отдельно; для независимости выберите другую модель.
# По умолчанию парное сравнение работает без платного судьи.
JUDGE_BASE_URL=https://ai.api.cloud.yandex.net/v1
JUDGE_MODEL=gpt://<folder-id>/deepseek-v4-flash

# Данные и сервисы
DATA_DIR=data
REPORT_SOURCE=snapshot            # snapshot | sqlite
INDEX_PATH=.cache/snapshot.sqlite
MCP_TRANSPORT=stdio               # stdio | streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8765
API_HOST=127.0.0.1
API_PORT=8080
RECURSION_LIMIT=32
RUNS_DIR=runs

# Локальный запуск: SQLite сохраняет историю между запусками процесса.
SESSION_STORE=sqlite             # sqlite | postgres | memory (только временные эксперименты)
# SESSION_DB_PATH=runs/sessions.sqlite3
SESSION_CONNECT_TIMEOUT_S=5
SESSION_POOL_SIZE=5

# Compose и Kubernetes: PostgreSQL вне API-контейнера. В Compose SESSION_STORE=postgres
# задаётся принудительно. Заполните оба значения для встроенного сервиса postgres.
# Если пароль содержит спецсимволы URI, закодируйте их в SESSION_DATABASE_URL.
# POSTGRES_PASSWORD=<случайный пароль>
# SESSION_DATABASE_URL=postgresql://contractor:<пароль>@postgres:5432/contractor
# В Kubernetes DSN внешней базы (с TLS) передаётся через Secret.
