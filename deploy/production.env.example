# Copy to .env.production, chmod 600. Keep secrets outside Git and image layers.
SITE_HOST=your-domain.example
APP_VERSION=local
WEB_PASSWORD=replace-with-your-stand-key
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_MODEL=gpt://YOUR_FOLDER_ID/gpt-oss-120b
YANDEX_API_KEY=replace-with-your-api-key
LLM_FALLBACK_MODELS=
LLM_API_KEY_OVERRIDE=
LLM_MAX_TOKENS=8192
LLM_REASONING_EFFORT=low
