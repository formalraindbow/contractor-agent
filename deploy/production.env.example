# Copy to .env.production, chmod 600. Keep secrets outside Git and image layers.
SITE_HOST=your-domain.example
APP_VERSION=local
WEB_PASSWORD=replace-with-your-stand-key
LLM_BASE_URL=https://polza.ai/api/v1
LLM_MODEL=openai/gpt-oss-20b
POLZA_API_KEY=replace-with-your-api-key
LLM_PROVIDER_ORDER=groq,akashml
LLM_PROVIDER_ALLOW_FALLBACKS=true
JUDGE_BASE_URL=https://polza.ai/api/v1
